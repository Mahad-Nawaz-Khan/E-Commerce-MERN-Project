# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/exclusive

# JWT secrets — MUST be set, no fallbacks. Use long random strings.
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long-random
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long-random
JWT_EMAIL_SECRET=change-me-email-min-32-chars-long-random

# Token expiry
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email via Gmail SMTP — the password is a Google App Password
# (Google Account → Security → 2-Step Verification → App passwords),
# NOT your normal Gmail password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=Exclusive <yourgmail@gmail.com>

# SafePay (leave blank to run COD-only; add sandbox keys to enable)
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=
SAFEPAY_V1_SECRET=
SAFEPAY_WEBHOOK_SECRET=

# Stripe (leave blank to disable card checkout)
# STRIPE_SECRET_KEY from https://dashboard.stripe.com/test/apikeys (sk_test_...)
# STRIPE_WEBHOOK_SECRET from the webhook endpoint settings (whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Cloudinary (required for image uploads — admin media library)
# Leave blank to run without uploads; POST /api/media returns 503 until set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=exclusive-ecommerce
